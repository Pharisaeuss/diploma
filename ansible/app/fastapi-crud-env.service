[Unit]
Description=Fetch FastAPI runtime config from AWS SSM
# Must complete before the app starts
Before=fastapi-crud.service
After=network-online.target cloud-final.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/fastapi-crud/bootstrap.env
ExecStart=/usr/local/bin/fetch-runtime-env.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastapi-crud-env

# Retry a few times — instance profile credentials may not be ready instantly
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
