[Unit]
Description=FastAPI CRUD App (uvicorn)
# Wait for SSM env fetch to complete before starting
After=network.target fastapi-crud-env.service
Requires=fastapi-crud-env.service

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_dir }}

# runtime.env is written by fastapi-crud-env.service (fetch-runtime-env.sh)
# It contains DATABASE_URL, ENV, AWS_DEFAULT_REGION, etc.
EnvironmentFile=/etc/fastapi-crud/runtime.env

ExecStart={{ app_dir }}/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port {{ app_port }} \
    --workers 2 \
    --log-level info

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastapi-crud

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ app_dir }}

[Install]
WantedBy=multi-user.target
