[Unit]
Description=FastAPI CRUD App (uvicorn)
After=network.target fastapi-crud-env.service

# Wants (not Requires) — if the env fetcher fails transiently, systemd
# will still attempt to start this unit. The app itself handles a missing
# DB via the _wait_for_db() retry loop in lifespan startup.
Wants=fastapi-crud-env.service

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_dir }}

# Written by fastapi-crud-env.service at boot
EnvironmentFile=/etc/fastapi-crud/runtime.env

ExecStart={{ app_dir }}/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port {{ app_port }} \
    --workers 2 \
    --log-level info

# ── Restart policy ────────────────────────────────────────────────────────────
# Restart on any non-clean exit (crash, OOM, DB not ready yet on boot).
Restart=on-failure
RestartSec=15

# Allow up to 10 restarts in 20 minutes.
# RDS cold start takes up to 10 min; the app retries internally for ~3 min
# per attempt, so this window covers the full race condition on first boot.
StartLimitIntervalSec=1200
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastapi-crud

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ app_dir }}

[Install]
WantedBy=multi-user.target
