import streamlit as st
import pandas as pd
from sqlalchemy import create_engine, text
import datetime
import urllib.parse  

# Налаштування сторінки
st.set_page_config(page_title="DevOps Dashboard", page_icon="🚀", layout="wide")
st.title("🚀 Моніторинг Інфраструктури (Дипломний проєкт)")
st.markdown("Цей дашборд розгорнуто автоматично через **GitHub Actions + Ansible** на базі **AWS EC2 (Amazon Linux 2023)**.")

# Безпечне кодування пароля (ховаємо спецсимволи типу @, /, #)
raw_password = "{{ db_password }}"
encoded_password = urllib.parse.quote_plus(raw_password)

# Підключення до БД (Додано sslmode=require для сумісності з AWS RDS)
DB_URI = f"postgresql://postgres:{encoded_password}@{{ db_host }}:5432/postgres?sslmode=require"

@st.cache_resource
def init_connection():
    return create_engine(DB_URI)

try:
    engine = init_connection()
    
    # Створюємо таблицю, якщо її немає (Замість ручних міграцій!)
    with engine.connect() as conn:
        conn.execute(text("""
            CREATE TABLE IF NOT EXISTS access_logs (
                id SERIAL PRIMARY KEY,
                visit_time TIMESTAMP NOT NULL
            )
        """))
        # Записуємо поточний візит
        conn.execute(text("INSERT INTO access_logs (visit_time) VALUES (:time)"), {"time": datetime.datetime.utcnow()})
        conn.commit()

    st.success("✅ Успішне підключення до AWS RDS PostgreSQL!")

    # Читаємо дані для графіка
    df = pd.read_sql("SELECT visit_time FROM access_logs", engine)
    df['visit_time'] = pd.to_datetime(df['visit_time'])
    df['date'] = df['visit_time'].dt.date

    # Групуємо і малюємо графік
    st.subheader("📊 Графік відвідуваності дашборду")
    visits_per_day = df.groupby('date').size().reset_index(name='visits')
    st.bar_chart(visits_per_day.set_index('date'))

    with st.expander("Детальні логи БД"):
        st.dataframe(df.tail(10)) # Показуємо останні 10 записів

except Exception as e:
    st.error(f"❌ Помилка підключення до бази даних: {e}")