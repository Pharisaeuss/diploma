server {
    # Слухаємо стандартний веб-порт
    listen 80;
    
    # Приймаємо запити з будь-яких IP/доменів (бо попереду ще буде ALB)
    server_name _;

    location / {
        # Перенаправляємо весь трафік на наш Gunicorn
        proxy_pass http://127.0.0.1:8000;
        
        # Передаємо реальні IP адреси користувачів, щоб Flask знав, хто до нього прийшов
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
